# Copy to .env.local (git-ignored) and adjust. No secrets belong in this file.

# Where the Next.js SERVER reaches the API. Used for server-side fetches and as
# the target of the /api/* rewrite (next.config.ts). Never sent to the browser:
# the browser only talks to this site's own origin, so this can be a private
# or internal address. No trailing slash. Default: http://localhost:5246
API_INTERNAL_URL=http://localhost:5246

# Optional. The public address of the site (https://... behind a tunnel or on
# your own domain), without a trailing slash. Used for absolute links in shared
# previews (an article's cover image) and, in production over https, to add
# "upgrade-insecure-requests" to the CSP. On Vercel it defaults to the
# project's production domain, so it can be left unset there.
# SITE_URL=https://example.org
